{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-bloom-marketplace",
  "main": "src/index.mjs",
  "compatibility_date": "2024-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Turns src/ui/*.html into src/ui/generated.mjs before every deploy.
  "build": { "command": "node scripts/build-ui.mjs" },

  // Hourly: start a new day for creator capacity (Israel time) and refresh tokens.
  "triggers": { "crons": ["5 * * * *"] },

  // Public, non-secret values only. This repo is public.
  // Secrets (set in Cloudflare → Worker → Settings → Variables and Secrets):
  //   SHOPIFY_API_KEY, SHOPIFY_API_SECRET, TURSO_DATABASE_URL, TURSO_AUTH_TOKEN,
  //   optional: STRIPE_SECRET, RESEND_API_KEY
  "vars": {
    "SHOP": "flowersmarketplace.myshopify.com",
    "API_VERSION": "2026-10",
    "PROXY_PREFIX": "/apps/mb",
    "PRODUCT_TYPE": "Bouquet",
    "NOTIFY_FROM": ""
  },

  // Preview builds (non-main branches). Same public values; previews have no cron.
  "previews": {
    "vars": {
      "SHOP": "flowersmarketplace.myshopify.com",
      "API_VERSION": "2026-10",
      "PROXY_PREFIX": "/apps/mb",
      "PRODUCT_TYPE": "Bouquet",
      "NOTIFY_FROM": ""
    }
  }
}
